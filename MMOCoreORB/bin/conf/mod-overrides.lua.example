-- ============================================================================
-- mod-overrides.lua -- Custom Skills mod :: SWGEMU option overlay
-- ============================================================================
--
-- HOW IT WORKS
--   ConfigManager loads conf/config.lua -> conf/config-local.lua ->
--   conf/mod-overrides.lua into ONE shared Lua state, then does a single
--   parse pass. Last assignment wins, so any line you UNCOMMENT here
--   overrides both the shipped defaults and your own config-local.lua.
--
-- SPARSE BY DEFAULT
--   Every line below is commented out. While everything stays commented,
--   this file is a no-op and your operator values always win. To force a
--   value, delete the leading "-- " from exactly that line.
--
-- TO REGAIN CONTROL
--   Re-comment the line (put "-- " back at its start) or delete it, then
--   hot-reload config (or restart). The value reverts to whatever
--   config-local.lua / config.lua set.
--
-- TAGS
--   [dyn]        -- applies immediately on config reload
--   [dyn-cache]  -- applies on reload; cached getter auto-refreshes
--   [restart]    -- read once at startup; restart required
--
-- EXCLUDED BY DESIGN: credentials/secrets (DBPass, DBSecret, APIToken,
-- SSLKeyFile/CertFile...) are never listed here; dead-read keys and
-- naming-trap keys (accountVictimList, DestoryOrphans) are omitted.
-- Units: durations are ms unless noted; basis points 1000 bp = 10.00%.
-- ============================================================================

-- ---------------------------------------------------------------------------
-- Player Manager (gameplay toggles)
-- ---------------------------------------------------------------------------

-- Galaxy-wide grouping: allow group invite across zones/planets.
-- type: bool, default: false. [dyn]
-- Core3.PlayerManager.GalaxyWideGrouping = true

-- Advanced waypoints: enable waypoint route planning on /waypoint.
-- type: bool, default: false. [dyn]
-- Core3.PlayerManager.AdvancedWaypoints = true

-- Wipe ham "filling" wounds on clone respawn.
-- type: bool, default: false. [dyn]
-- Core3.PlayerManager.WipeFillingOnClone = true

-- Hide player visibility tracking entirely (reduces load; affects bounty
-- visibility). type: bool, default: false. [restart] (cached in VisibilityManager)
-- Core3.PlayerManager.DisableGroupVisibility = false

-- Client version gate: clients reporting another version are refused.
-- type: string, default: "20050408-18:00". [dyn]
-- Core3.PlayerManager.ValidClientVersion = "20050408-18:00"

